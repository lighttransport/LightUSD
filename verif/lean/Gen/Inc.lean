/-!
X-macro `.inc` emitter shared by all vector generators.

Each generator returns `(relativePath, content)` pairs; `Gen.Main` writes or
checks them under `tests/next/generated/lean/`.
-/
namespace Gen

def header (generator : String) : String :=
  s!"// GENERATED by verif/lean ({generator}) via `lake exe usdspec-gen` — do not edit.\n" ++
  "// Expected values are computed by the Lean definitions of the AOUSD USD Core\n" ++
  "// Specification v1.1.0 formalization (verif/lean/UsdSpec). Regenerate with\n" ++
  "//   cd verif/lean && lake exe usdspec-gen --out ../../tests/next/generated/lean\n" ++
  "// and check for drift with `--check`.\n"

/-- C string literal escaping (ASCII-safe; non-ASCII emitted as UTF-8 bytes). -/
def cstr (s : String) : String := Id.run do
  let mut out := "\""
  for c in s.toList do
    if c == '"' then out := out ++ "\\\""
    else if c == '\\' then out := out ++ "\\\\"
    else if c == '\n' then out := out ++ "\\n"
    else if c == '\t' then out := out ++ "\\t"
    else if c.toNat < 0x20 || c.toNat == 0x7f then out := out ++ s!"\\{c.toNat}"  -- never used in practice
    else out := out.push c
  return out ++ "\""

/-- Comma-separated integer list literal as a string, e.g. `"1,2,3"`. -/
def intList (l : List Int) : String := ",".intercalate (l.map toString)

def row (macroName : String) (args : List String) : String :=
  s!"{macroName}({", ".intercalate args})\n"

/-- Deterministic LCG for sampling (numerical recipes constants). -/
structure Lcg where seed : UInt64
def Lcg.next (g : Lcg) : Lcg × Nat :=
  let s := g.seed * 6364136223846793005 + 1442695040888963407
  (⟨s⟩, (s >>> 33).toNat)

end Gen
