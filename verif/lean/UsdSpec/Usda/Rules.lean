/-! ## G1 well-formedness, G3 keywords, G4 path agreement (all by `decide`) -/

/-- The full grammar after overriding with `repairs`. -/
def usdaRepaired : Grammar := repairs ++ usda

/-- G1: every referenced nonterminal is defined, except `TimeSampleOrDefault` (referenced at L10779).
SPEC: core_spec.md L10779-10787 (RelationshipSpec); `TimeSampleOrDefault` is defined only in the
non-normative legacy section (L11489).
SPEC-ISSUE: LEAN-802 — normative `RelationshipSpec` references a rule the normative grammar never defines. -/
theorem undefinedRefs_usda : undefinedRefs usda = ["TimeSampleOrDefault"] := by decide +kernel

theorem undefinedRefs_repaired : undefinedRefs usdaRepaired = [] := by decide +kernel

/-- G1: no rule name is bound twice (the path chapter's colliding names live under `Path.`). -/
theorem duplicateNames_usda : duplicateNames usda = [] := by decide +kernel

/-- G1: rules not reachable from `LayerSpec` (`StringDictionary` is used only by the legacy
`prefixSubstitutions`/`suffixSubstitutions`, L11494-11498; `ReservedCharacters` is informative). -/
theorem unreachable_usda : unreachable usda "LayerSpec" = ["StringDictionaryItem", "StringDictionary", "Path.ReservedCharacters", "List<StringDictionaryItem>"] := by decide +kernel

/-- Identifier-shaped literals used by the rules other than `Keyword` itself. -/
def ruleWords : List String := wordLits (usda.filter (fun r => r.1 != "Keyword" && !("Path.".toList.isPrefixOf r.1.toList)))

/-- G3: the keyword table L9935-9993 lists `varying`, which no rule uses (`AttributeVariability`,
L10431, has only `uniform`); and the rules use `autoEase` (L10271), `inf`/`nan` (L9715-9717)
and `usda` (L11204) as literals that are not reserved, so `autoEase` is an `Identifier` too.
SPEC-ISSUE: LEAN-804 — keyword table and rule literals disagree. -/
theorem keywords_unused : keywordTable.filter (fun k => !ruleWords.contains k) = ["varying"] := by decide +kernel

theorem ruleWords_not_reserved : (ruleWords.filter (fun w => w.toList.length > 1 && !keywordTable.contains w)) = ["inf", "nan", "autoEase", "usda"] := by decide +kernel

/-- Path vector samples (same list as `Gen.PathSchemaVec.pathSamples`). -/
def pathSamples : List String := ["/", ".", "..", "../..", "../../A/B", "/A", "/A/B", "/A/B.c", "/A.b", "/A.b:c:d", "A", "A/B", "A.b", ".b", "../A.b", "/A{v=x}", "/A{v=x}B", "/A{v=x}B/C", "/A/B{v=x}C", "/A{v=x}/B", "/A{v=}", "/A{v=x}{w=y}", "/A{v=x.y-z|w}", "/A{ v = x }", "/A.b.c", "a.b.c", "/A/", "//A", "/A//B", "/1A", "/_A", "/A_1", "/M\u00fcnchen", "/A-B", "/A.b:", "/A.:b", "/A{v=x}.p", "/Root/Child/Grandchild{size=1}/GreatGrandchild", "/World/Foo/Baz{VariantSet1=VarFoobar}Foobar.foobarprop1", "", " ", "/A B", "/A..", "/A/..", "/A/../B", "../", "/..", "/.", "/A.b[/C]"]

/-- G4: the path rules embedded in the USDA grammar (`Path.Path`, L3737) agree with the
hand transcription `UsdSpec.PathGrammar.Peg.accepts` on every path vector sample. -/
theorem path_rules_agree :
    pathSamples.all (fun s => accepts usda "Path.Path" s 1000 == UsdSpec.PathGrammar.Peg.accepts s) = true := by
  decide +kernel

/-- LEAN-805 witness: `BasePart` (L9704-9706) tries `(Digit)+` first, which commits on `1`
and leaves `.5`, so no decimal with a fraction is a `Number`.
SPEC-ISSUE: LEAN-805 — `BasePart` alternatives are in prefix order; `1.5` is not a `Number`. -/
theorem number_decimal_rejected :
    run usda "Number" "1.5".toList 100 = some 1 ∧ accepts usda "Number" "1.5" = false
    ∧ accepts usdaRepaired "Number" "1.5" = true ∧ accepts usda "Number" ".5" = true
    ∧ accepts usda "Number" "-1e-7" = true := by decide +kernel

/-- LEAN-806 witness: `!(Keyword)` (L10021) fails on any identifier with a keyword *prefix*.
SPEC-ISSUE: LEAN-806 — `KeywordlessIdentifier` rejects `defaultPrim`, `customLayerData`, `prefix`. -/
theorem keyword_prefix_rejected :
    accepts usda "Identifier" "defaultPrim" = false ∧ accepts usda "Identifier" "customLayerData" = false
    ∧ accepts usda "Identifier" "upAxis" = true
    ∧ accepts usdaRepaired "Identifier" "defaultPrim" = true
    ∧ accepts usdaRepaired "Identifier" "def" = false := by decide +kernel

/-- LEAN-807 witness: `AttributeSpec` alternative 1 (L10466-10468) succeeds on the bare
declaration, so alternative 2 (`.timeSamples`/`.connect`/`.spline`, L10469-10470) is unreachable.
SPEC-ISSUE: LEAN-807 — `float a.timeSamples = {...}` is not a `PropertySpec`. -/
theorem attr_special_unreachable :
    run usda "AttributeSpec" "float a.timeSamples = { }".toList 1000 = some 7
    ∧ accepts usda "AttributeSpec" "float a.timeSamples = { }" = false
    ∧ accepts usdaRepaired "AttributeSpec" "float a.timeSamples = { }" = true := by decide +kernel

/-- LEAN-808 witness: `customData` is a keyword (L9953), so it is no `KeyValueMetadata`
(L10369) and only `ReferenceParameter` (L10839) has a rule for it.
SPEC-ISSUE: LEAN-808 — prim/property/layer `customData = {...}` has no production. -/
theorem customData_metadata_rejected :
    accepts usda "SharedMetadata" "customData = {}" = false
    ∧ accepts usdaRepaired "SharedMetadata" "customData = {}" = true
    ∧ accepts usda "ReferenceParameter" "customData = {}" = true := by decide +kernel

/-- LEAN-809 witness: `Utf8Character` (L9680-9697) starts at U+0020, so a multiline string
(L9750-9776) cannot span lines and cannot hold a lone quote; the same for `/* */` (L9895).
SPEC-ISSUE: LEAN-809 — multiline strings/comments cannot contain line breaks. -/
theorem multiline_newline_rejected :
    accepts usda "String" "\"\"\"a\nb\"\"\"" = false ∧ accepts usdaRepaired "String" "\"\"\"a\nb\"\"\"" = true
    ∧ accepts usda "String" "'''it's'''" = false ∧ accepts usdaRepaired "String" "'''it's'''" = true
    ∧ accepts usda "Comment" "/* a\nb */" = false ∧ accepts usdaRepaired "Comment" "/* a\nb */" = true := by
  decide +kernel

/-- LEAN-810 witness: TAB is not a `Utf8Character`.
SPEC-ISSUE: LEAN-810 — a tab inside a string or comment is not in the language. -/
theorem tab_in_string_rejected :
    accepts usda "String" "\"a\tb\"" = false ∧ accepts usdaRepaired "String" "\"a\tb\"" = true
    ∧ accepts usda "Comment" "# a\tb" = false := by decide +kernel

/-- LEAN-801 (M4) re-checked on the full grammar: `prepend apiSchemas = []` is not
`ListOpMetadata`, `prepend apiSchemas = ["A"]` is; `references = []` is. -/
theorem lean801_full_grammar :
    accepts usda "ListOpMetadata" "prepend apiSchemas = []" = false
    ∧ accepts usda "ListOpMetadata" "prepend apiSchemas = [\"A\"]" = true
    ∧ accepts usda "ReferencesMetadata" "references = []" = true := by decide +kernel

end UsdSpec.Usda.Peg
