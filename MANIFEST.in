# sdist contents for the lightusd PyPI package.
# Everything needed to run `python -m build --wheel` from the sdist itself.
# The wheel builds the core library (src/), Tydra (src/tydra), the C API and
# the Python extension. src/legacy is never included; src/external only the
# vendored pieces the core build compiles (all headers are kept).

include LICENSE
include README.md
include pyproject.toml
include setup.py

# Core + Tydra + C API + extension sources.
recursive-include src *.cc *.c *.h *.hh *.inc *.txt *.json *.cmake
recursive-include src/tydra *.cc *.hh *.txt *.comp
recursive-include src/c-api *.cc *.h *.hh
recursive-include src/python *.c *.h
include src/lz4/lz4.c src/lz4/lz4.h
recursive-include src/external/fast_float/include *.h
include src/external/dragonbox/dragonbox.h
include src/mtlx-xml-tokenizer.cc src/mtlx-xml-tokenizer.hh
include src/mtlx-xml-parser.cc src/mtlx-xml-parser.hh
include src/core/mtlx-dom.cc src/core/mtlx-dom.hh

# Python package + tests.
recursive-include python *.py *.pyi py.typed README.md
recursive-include python/tests *.py

# Small USDA assets used by the pytest suite (skip-if-missing otherwise).
recursive-include tests/usda *.usda

# setuptools_scm's git file-finder would otherwise include every tracked
# file; prune everything the wheel build does not need.
prune examples
prune web
prune models
prune sandbox
prune doc
prune benchmark
prune benchmarks
prune blender
prune aousd
prune schema
prune data
prune container
prune cmake
prune android
prune ios
prune tests/usdc
prune tests/feat
prune tests/legacy/unit
prune tests/fuzzer
prune tests/core
prune tests/tydra
prune tests/c-api
prune tests/composition
prune src/external
prune src/osd
prune tools
prune subprojects
exclude resume-*.md
prune scripts
# Transitive standalone-next inputs. Headers are inexpensive and keeping the
# complete src/ header surface avoids a fragile hand-maintained include graph.
recursive-include src *.h *.hh *.hpp *.inc *.inl *.txt
include src/core/color-transform.cc src/core/logger.cc src/core/minijson.cc
include src/mtlx-xml-tokenizer.cc src/mtlx-xml-parser.cc src/core/mtlx-dom.cc
include src/ptx-loader.cc
recursive-include src/external/textools/ptex/src *.c
recursive-include src/tsd *.cc
include src/external/miniz.c src/external/mikktspace/mikktspace.c
# Configure-time inputs: src and tydra-next CMake define these targets
# even though the wheel only builds the four library targets, so every source
# they list must exist in the sdist (a missing file fails `cmake -S`).
include src/core/host-services.cc src/image-loader.cc src/image-writer.cc src/io-util.cc src/usdVol.cc
include tests/core/lusdcat.cc
recursive-include src/external/tinyvdb *.c *.h
recursive-include src/external/mimalloc *.c *.h
recursive-include tools/lusdpreview *.cc *.hh *.h
recursive-include cmake *.cmake

# Legacy sources are never part of the Python package.

# Strip build artefacts.
global-exclude *.pyc *.pyo *.so *.pyd __pycache__
prune build
prune build_py_ext
prune build_py_ext_nothread
prune build-next
prune dist
prune .git
prune .github
prune .clusterfuzzlite
prune .serena
prune screenshots

# Repository-only metadata and alternate build-system entry points are not
# needed to build the Python extension from an sdist.
exclude .cirrus.yml
exclude .clang-format
exclude .gitignore
exclude .gitleaksignore
exclude AGENTS.md
exclude CLAUDE.md
exclude CMakeLists.txt
exclude CMakePresets.json
exclude CMakeSettings.json
exclude exporter-fix.md
exclude lgtm.yaml
exclude meson.build
exclude meson.options
exclude resume-aousd.md
exclude resume-dev.md
exclude vk_layer_settings.txt
exclude xmake.lua
exclude *.bat

# Native scene imports used by the Python wheel (including all parser includes).
recursive-include src/tydra/asset-import *.cc *.hh
recursive-include src/external/tinyobjloader-c *.c *.h *.inc *.txt LICENSE
include src/external/pugixml.cpp
include src/unicode-xid-c.c
include src/external/zmij/zmij.cc
recursive-include cmake *.cmake *.in
recursive-include src *.cmake

# Last, so no earlier include pattern re-adds legacy files.
prune src/legacy
