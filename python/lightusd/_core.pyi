# ---- tydra render types ----

class RenderMesh:
    name: str
    prim_path: str
    point_count: int
    face_count: int
    material_id: int
    primvar_count: int
    blend_shape_count: int
    skeleton_id: int
    is_triangulated: bool
    has_skin: bool
    points: Optional[Array]
    face_vertex_counts: Optional[Array]
    face_vertex_indices: Optional[Array]
    triangulated_indices: Optional[Array]
    normals: Optional[Array]
    tangents: Optional[Array]
    texcoords0: Optional[Array]
    texcoords1: Optional[Array]
    colors: Optional[Array]
    joint_indices: Optional[Array]
    joint_weights: Optional[Array]
    bbox: Optional[tuple[tuple[float, float, float],
                         tuple[float, float, float]]]
    subsets: list[tuple[int, int, int]]
    def primvar(self, index: int) -> dict[str, Any]: ...
    def blend_shape(self, index: int) -> dict[str, Any]: ...

class RenderTexture:
    name: str
    asset_path: str
    image_id: int
    wrap_s: str
    wrap_t: str
    uv_offset: tuple[float, float]
    uv_scale: tuple[float, float]
    uv_rotation: float
    image: Optional["RenderImage"]

class RenderImage:
    name: str
    resolved_path: str
    width: int
    height: int
    channels: int
    is_loaded: bool
    data: Optional[Array]

class RenderMaterial:
    name: str
    prim_path: str
    shader: Optional[str]
    double_sided: bool
    alpha_mode: str
    alpha_cutoff: float
    def param(self, name: str) -> Union[tuple[float, float, float, float],
                                        RenderTexture, None]: ...

class RenderNode:
    name: str
    prim_path: str
    type: str
    visible: bool
    data_id: int
    parent_id: int
    local_transform: Matrix4
    world_transform: Matrix4
    children: tuple["RenderNode", ...]

class RenderLight:
    name: str
    prim_path: str
    type: str
    color: tuple[float, float, float]
    intensity: float
    exposure: float
    transform: Matrix4

class RenderCamera:
    name: str
    prim_path: str
    type: str
    focal_length: float
    horizontal_aperture: float
    vertical_aperture: float
    near_clip: float
    far_clip: float
    fov_x: float
    fov_y: float
    transform: Matrix4

class RenderScene:
    meshes: tuple[RenderMesh, ...]
    materials: tuple[RenderMaterial, ...]
    textures: tuple[RenderTexture, ...]
    images: tuple[RenderImage, ...]
    nodes: tuple[RenderNode, ...]
    lights: tuple[RenderLight, ...]
    cameras: tuple[RenderCamera, ...]
    root_nodes: tuple[RenderNode, ...]
    default_prim: str
    up_axis: str
    meters_per_unit: float
    start_time: float
    end_time: float
    def mesh_by_path(self, prim_path: str) -> Optional[RenderMesh]: ...
    def material_by_path(self, prim_path: str) -> Optional[RenderMaterial]: ...
    def warnings(self) -> list[str]: ...

