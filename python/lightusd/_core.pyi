"""Type stubs for the lightusd._core extension."""
from typing import Any, Iterator, Optional, Sequence, Union

__version__: str

Matrix4 = tuple[
    tuple[float, float, float, float],
    tuple[float, float, float, float],
    tuple[float, float, float, float],
    tuple[float, float, float, float],
]
Value = Any  # bool | int | float | str | tuple | Array | ValueBlock | dict

class UsdError(Exception): ...
class UsdParseError(UsdError, ValueError): ...
class UsdIoError(UsdError, OSError): ...
class StaleHandleError(UsdError): ...

class _ValueBlockType:
    def __repr__(self) -> str: ...

ValueBlock: _ValueBlockType

class Array:
    """Zero-copy view of an array-valued attribute / render buffer.

    Interops with numpy without copying: ``numpy.asarray(array)``.
    """

    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def dtype(self) -> str: ...
    @property
    def type_name(self) -> str: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def __array_interface__(self) -> dict[str, Any]: ...
    def memoryview(self) -> memoryview: ...
    def tolist(self) -> list[Any]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Any: ...
    def __iter__(self) -> Iterator[Any]: ...

class TimeSamples:
    @property
    def times(self) -> tuple[float, ...]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> tuple[float, Value]: ...
    def __iter__(self) -> Iterator[tuple[float, Value]]: ...

