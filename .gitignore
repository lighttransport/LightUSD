*.nvuser

# MFractors (Xamarin productivity tool) working folder
.mfractor/

# Local History for Visual Studio
.localhistory/

# BeatPulse healthcheck temp database
healthchecksdb

# Backup folder for Package Reference Convert tool in Visual Studio 2017
MigrationBackup/

compile_commands.json

# Cmake
CMakeUserPresets.json

# LightUSD/Crate-Writer specific
*.usdc
*.usda
# Note: the former
#   !web/demo/public/assets/metahuman-fixture/
#   !web/demo/public/assets/metahuman-fixture/*.usda
# exemptions were removed as dead rules. web/demo/public/assets/ is now
# ignored wholesale, and Git cannot re-include a path whose parent directory
# is excluded. The already-tracked fixtures there are unaffected; new ones
# need `git add -f`. See the assets/ rule above.
# But keep test fixtures
!tests/usda/*.usda
!tests/usda/spec/*.usda
!tests/unit/fixtures/*.usda
!tests/next/fixtures/*.usda
!tests/next/fixtures/vr-edge/**/*.usda
!tests/usda/validation/valid/*.usda
!models/concave_ngon.usda
!examples/lusdview/tests/deform-skin-animation.usda
# Small authored MaterialX closure/volume fixtures used by the Vulkan RT smoke.
!examples/lusdview/tests/authored-nested-closures.usda
!examples/lusdview/tests/authored-volume-material.usda
!tests/usdc/aousd-unknown-property-metadata.usdc
# Cross-layer list-op fixtures (Phase 7 S5; consumed by test_pcp, not the
# top-level usdcat round-trip compare which globs only tests/usda/*.usda).
!tests/usda/composition/listop-xlayer-*.usda
# lusdview material regression fixtures (lusdview-material-binding-inheritance /
# lusdview-asset-path-anchoring). Listed explicitly rather than un-ignoring all of
# models/*.usda, which would also catch scratch scenes dropped in that directory.
!models/lusdview-material-binding-inheritance.usda
!models/skintest-instanced.usda
!models/multi-uv-quad.usda
!models/nested-look-texture/root.usda
!models/nested-look-texture/look/look.usda
!tests/usda/validation/invalid/*.usda
!tests/usda/validation/generated/*.usda
!tests/feat/large-scene/fixture/**/*.usda
!models/lusdview-curves-ribbons.usda
!models/lusdview-nurbs-patch.usda
!models/lusdview-transparency.usda
!models/lusdquicklook-alpha-modes.usda
!models/日本語ファイル名テスト.usda
!tests/usdc/dedup-global-001.usdc
!aousd/validation_*.usda
# Test-generated runtime artifacts (roundtrip/runtime tests)
tests/usdc/memory-budget-*-runtime.usdc
tests/usdc/variant-*-runtime.usdc
# In-source CMake residue. `cmake .` run from a source directory by mistake
# drops these next to the sources; CMakeCache.txt in particular was reaching
# commits because only CMakeFiles/ and Makefile were listed here.
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CMakeFiles/
Makefile
cmake_install.cmake

# AOUSD spec PDFs (keep local only)
aousd/*.pdf

# OpenUSD source tree (should be external)
aousd/OpenUSD/

# OpenUSD build outputs
aousd/dist*/
.env
.mcp.json

# wasm
web/build
web/build_64

# js assets
web/js/assets/*
!web/js/assets/physics-robot-arm.usda

# vite build output
web/js/dist/

# fuzzer
tests/fuzzer/corpus/

# CTest artifacts (created when ctest runs from source dir)
Testing/

# Compiled test binaries under tests/feat/
tests/feat/*/test_*
tests/feat/*/**_bench
!tests/feat/*/test_*.cc
!tests/feat/*/test_*.cpp
!tests/feat/**/*_bench.cc
!tests/feat/**/*_bench.cpp

# Derived spec text files (generated from PDF)
aousd/spec/

# Build directories (CMake / ninja / pip editable extension)
build_py/
build_py_ext/
build_py_ext_next/
build-next/
build_test/
web/build_ninja/
web/build_64_ninja/

# Built CPython extension (regenerated by `pip install -e .`)
python/lightusd/_core.abi3.so
# next module's built CPython extension + generated stubs (regenerated by the build)
python/next/lightusd_next/_next_core.so
python/next/**/*.so
python/next/lightusd_next/_core.pyi

# Generated by vcs-versioning during editable/build installs
python/lightusd/_version.py

# Local AI assistant scratch files
.codex
.claude/

# Private notes / scratch docs (may reference proprietary asset names) — never commit
priv/
resume.md
# Root-level scratch notes only -- doc/resume-lusdview.md is tracked.
/resume-lusdview.md
gpu-task.md
python/lightusd.egg-info/
python/lightusd/_core.*.so

# lusdchecker composition regression fixtures
!tools/lusdchecker/testdata/type-mismatch-root.usda
!tools/lusdchecker/testdata/type-mismatch-weak.usda
!tools/lusdchecker/testdata/invalid-variant-body.usda
!tools/lusdchecker/testdata/unknown-api-schema.usda
!tools/lusdchecker/testdata/varying-relationship.usda

# lusdchecker ARKit profile fixtures
