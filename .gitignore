## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# App-specific
.opencode/

# UE MetaHuman USD bridge: generated project/build/export data.  The small
# project descriptor, plugin source and orchestration scripts remain tracked.
tools/ue-metahuman-usd/Binaries/
tools/ue-metahuman-usd/DerivedDataCache/
tools/ue-metahuman-usd/Intermediate/
tools/ue-metahuman-usd/Saved/
tools/ue-metahuman-usd/Content/Generated/
tools/ue-metahuman-usd/Config/DefaultInput.ini
tools/ue-metahuman-usd/output/
tools/ue-metahuman-usd/Plugins/*/Binaries/
tools/ue-metahuman-usd/Plugins/*/Intermediate/

# macOS metadata
.DS_Store

# Locally built glslang (examples/common/build-glslang.sh) — build artifacts.
examples/common/glslang/
examples/common/glslang-src/
build/
build_ninja/
build-tinysubdiv/
build-*/
build_*/
large-scene-tasks.md
tests/asset-parse-results/
tests/asset-parse-results-flatten/
.cache/lightusd-verification/
ref/openusd/
ref/openusd-build/
ref/openusd-build*/
ref/openusd-venv/
ref/dist/
ref/dist*/
web/demo/dist/
web/demo/assets-src/
web/demo/public/assets/openchess/
# The whole demo asset folder is ignored: it is a staging area for large
# third-party sample downloads (AnimFinal_LowRes.usdz ~58 MB,
# StandingRunForward.usdz ~29 MB, DamagedHelmet.usdz ~5 MB, ...), not source.
# The ~130 fixtures already tracked under it stay tracked -- .gitignore only
# affects untracked paths. Anything new added here must be force-added:
#   git add -f web/demo/public/assets/<file>
web/demo/public/assets/
web/site/dist/
web/build_ninja/
web/cmake-build/
web/cmake-build64/
web/cmake-build-next/
web/cmake-build-next64/
web/cmake-build*-configure.log
web/cmake-build*-build.log
web/npm/dist/
web/npm/.tmp-package-smoke/
web/npm/.nodejs/
web/npm/.emsdk/

