#usda 1.0
(
    doc = "Two NATIVE-INSTANCED copies of the animated skinned rig (skintest-animated.usda). Regression fixture for --core instanced-prototype skinning: the prototype's SkelRoot must pose (and animate) inside every instance, not render at rest. All instances of a prototype necessarily share one skeleton + animation, so they pose identically and differ only by placement."
    defaultPrim = "world"
    endTimeCode = 48
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "world"
{
    def Xform "InstanceA" (
        instanceable = true
        prepend references = @skintest-animated.usda@</root>
    )
    {
        double3 xformOp:translate = (-1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "InstanceB" (
        instanceable = true
        prepend references = @skintest-animated.usda@</root>
    )
    {
        double3 xformOp:translate = (1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
