#usda 1.0
(
    defaultPrim = "Root"
    doc = "lmetalview animation test: a cube translating along +X."
    endTimeCode = 10
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Root"
{
    def Xform "Spinner"
    {
        double3 xformOp:translate.timeSamples = {
            0: (0, 0, 0),
            10: (4, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Cube" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 0
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 1, 5, 6, 2, 2, 6, 7, 3, 3, 7, 4, 0]
            point3f[] points = [(-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (0.5, 0.5, 0.5), (-0.5, 0.5, 0.5), (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5), (0.5, 0.5, -0.5), (-0.5, 0.5, -0.5)]
            rel material:binding = </Root/Material>
        }
    }

    def Material "Material"
    {
        token outputs:surface.connect = </Root/Material/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.68, 0.72)
            float inputs:metallic = 0.1
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }
}
