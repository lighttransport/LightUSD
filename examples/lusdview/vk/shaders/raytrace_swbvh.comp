        heroChannel = min(int(swRandom(seed) * 3.0), 2);
        transmissionC *= heroChannel == 0 ? vec3(3.0, 0.0, 0.0)
                       : heroChannel == 1 ? vec3(0.0, 3.0, 0.0)
                                          : vec3(0.0, 0.0, 3.0);
      }
      float materialIor = swPtSpectralIor(
          s.ior, s.dispersionAbbe, s.dispersion,
          heroChannel < 0 ? 1 : heroChannel);
