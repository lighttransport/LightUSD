      float pdf;
      nextDir = swPtSampleGgx(s.n, -rd, s.roughness, s.anisotropy,
                              s.anisotropyRotation, seed, pdf);
      float nl = max(dot(s.n, nextDir), 0.0);
      if (nl <= 0.0 || pdf <= 1.0e-8) break;
      reflectionSample = true; previousDelta = false;
    } else {
      nextDir = swPtCosine(s.n, seed);
      reflectionSample = true; previousDelta = false;
    }
    if (reflectionSample) {
      float pdf;
      vec3 reflection = swPtEvaluateReflection(
          s, -rd, nextDir, diffuseC, f0, sheenC, coatF0,
          pd, pg, pcg, pdf);
      float nl = max(dot(s.n, nextDir), 0.0);
      if (pdf <= 1.0e-8 || nl <= 0.0) break;
      weight = reflection * (nl / pdf);
      previousBsdfPdf = pdf;
