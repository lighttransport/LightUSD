    swGeomPropBc = bc;
    if (!inSubsurface && mediumDepth > 0) {
      vec3 tr = exp(-mediumSigma[mediumDepth] * hitT);
      vec3 ms = mediumSigma[mediumDepth];
      vec3 integral = vec3(
          ms.x > 1.0e-6 ? (1.0 - tr.x) / ms.x : hitT,
          ms.y > 1.0e-6 ? (1.0 - tr.y) / ms.y : hitT,
          ms.z > 1.0e-6 ? (1.0 - tr.z) / ms.z : hitT);
