                                 wv0, e1w, e2w);
        vec3 dyB = swBarycentric(swPlanePoint(dyO, dyD, planeN, planeD),
                                 wv0, e1w, e2w);
        bool baseUsesUv1 = swMaterialUsesUv1(mid, 0) &&
                           uvs1.length() >= uint(hitTri * 6 + 6);
        vec2 q0 = baseUsesUv1
                      ? vec2(uvs1[hitTri * 6 + 0], uvs1[hitTri * 6 + 1])
                      : vec2(uvs[hitTri * 6 + 0], uvs[hitTri * 6 + 1]);
        vec2 q1 = baseUsesUv1
                      ? vec2(uvs1[hitTri * 6 + 2], uvs1[hitTri * 6 + 3])
                      : vec2(uvs[hitTri * 6 + 2], uvs[hitTri * 6 + 3]);
        vec2 q2 = baseUsesUv1
                      ? vec2(uvs1[hitTri * 6 + 4], uvs1[hitTri * 6 + 5])
                      : vec2(uvs[hitTri * 6 + 4], uvs[hitTri * 6 + 5]);
        vec2 sourceUv = baseUsesUv1 ? uv1 : uv0;
        vec2 duvdx = q0 * dxB.x + q1 * dxB.y + q2 * dxB.z - sourceUv;
        vec2 duvdy = q0 * dyB.x + q1 * dyB.y + q2 * dyB.z - sourceUv;
        vec2 baseUv = swMaterialUvSets(mid, 0, uv0, uv1);
        vec2 baseDuvdx = swMaterialUv(mid, 0, sourceUv + duvdx) - baseUv;
        vec2 baseDuvdy = swMaterialUv(mid, 0, sourceUv + duvdy) - baseUv;
        vec4 bt = swSampleTexture(baseTexId, baseUv, baseDuvdx, baseDuvdy,
                                  sourceFace, vec4(1.0));
        bt = bt * vec4(matTexParams[uint(mid) * 155u + 36u],
                       matTexParams[uint(mid) * 155u + 37u],
                       matTexParams[uint(mid) * 155u + 38u],
                       matTexParams[uint(mid) * 155u + 39u]) +
             vec4(matTexParams[uint(mid) * 155u + 40u],
                  matTexParams[uint(mid) * 155u + 41u],
                  matTexParams[uint(mid) * 155u + 42u],
                  matTexParams[uint(mid) * 155u + 43u]);
        base *= bt.rgb;
        alpha *= bt.a;
      }
      uint texBase = uint(mid) * 12u;
      uint texParamBase = uint(mid) * 155u;
      vec4 mt = swSampleTexture(matTexIds[texBase + 1u],
                                swMaterialUvSets(mid, 1, uv0, uv1), vec2(0.0),
                                vec2(0.0), sourceFace, vec4(1.0));
      vec4 rt = swSampleTexture(matTexIds[texBase + 2u],
                                swMaterialUvSets(mid, 2, uv0, uv1), vec2(0.0),
                                vec2(0.0), sourceFace, vec4(1.0));
      metallic = clamp(metallic *
          (swTexChannel(mt, int(matTexParams[texParamBase + 60u] + 0.5)) *
           matTexParams[texParamBase + 61u] +
           matTexParams[texParamBase + 62u]), 0.0, 1.0);
      roughness = clamp(roughness *
          (swTexChannel(rt, int(matTexParams[texParamBase + 63u] + 0.5)) *
           matTexParams[texParamBase + 64u] +
           matTexParams[texParamBase + 65u]), 0.03, 1.0);
      int emissiveTex = matTexIds[texBase + 4u];
      if (emissiveTex >= 0) {
        vec4 et = swSampleTexture(emissiveTex,
                                  swMaterialUvSets(mid, 4, uv0, uv1),
                                  vec2(0.0), vec2(0.0), sourceFace,
                                  vec4(1.0));
        et = et * vec4(matTexParams[texParamBase + 52u],
                       matTexParams[texParamBase + 53u],
                       matTexParams[texParamBase + 54u],
                       matTexParams[texParamBase + 55u]) +
             vec4(matTexParams[texParamBase + 56u],
                  matTexParams[texParamBase + 57u],
                  matTexParams[texParamBase + 58u],
                  matTexParams[texParamBase + 59u]);
        emissive *= et.rgb;
      }
      int normalTex = matTexIds[texBase + 3u];
      if (normalTex >= 0) {
        vec4 nt = swSampleTexture(normalTex,
                                  swMaterialUvSets(mid, 3, uv0, uv1),
                                  vec2(0.0), vec2(0.0), sourceFace,
                                  vec4(0.5, 0.5, 1.0, 1.0));
        nt = nt * vec4(matTexParams[texParamBase + 44u],
                       matTexParams[texParamBase + 45u],
                       matTexParams[texParamBase + 46u],
                       matTexParams[texParamBase + 47u]) +
             vec4(matTexParams[texParamBase + 48u],
                  matTexParams[texParamBase + 49u],
                  matTexParams[texParamBase + 50u],
                  matTexParams[texParamBase + 51u]);
        vec3 wp0 = xformPoint(inst.o2w, vec3(tris[hitTri * 9 + 0],
                                              tris[hitTri * 9 + 1],
                                              tris[hitTri * 9 + 2]));
        vec3 wp1 = xformPoint(inst.o2w, vec3(tris[hitTri * 9 + 3],
                                              tris[hitTri * 9 + 4],
                                              tris[hitTri * 9 + 5]));
        vec3 wp2 = xformPoint(inst.o2w, vec3(tris[hitTri * 9 + 6],
                                              tris[hitTri * 9 + 7],
                                              tris[hitTri * 9 + 8]));
        bool normalUsesUv1 = swMaterialUsesUv1(mid, 3) &&
                             uvs1.length() >= uint(hitTri * 6 + 6);
        vec2 n0uv = normalUsesUv1
                        ? vec2(uvs1[hitTri * 6 + 0], uvs1[hitTri * 6 + 1])
                        : vec2(uvs[hitTri * 6 + 0], uvs[hitTri * 6 + 1]);
        vec2 n1uv = normalUsesUv1
                        ? vec2(uvs1[hitTri * 6 + 2], uvs1[hitTri * 6 + 3])
                        : vec2(uvs[hitTri * 6 + 2], uvs[hitTri * 6 + 3]);
        vec2 n2uv = normalUsesUv1
                        ? vec2(uvs1[hitTri * 6 + 4], uvs1[hitTri * 6 + 5])
                        : vec2(uvs[hitTri * 6 + 4], uvs[hitTri * 6 + 5]);
        vec2 t0 = swMaterialUv(mid, 3, n0uv);
        vec2 t1 = swMaterialUv(mid, 3, n1uv);
        vec2 t2 = swMaterialUv(mid, 3, n2uv);
        vec2 d1 = t1 - t0, d2 = t2 - t0;
        float tdet = d1.x * d2.y - d1.y * d2.x;
        vec3 tangentRaw = abs(tdet) > 1e-12
                              ? ((wp1 - wp0) * d2.y -
                                 (wp2 - wp0) * d1.y) / tdet
                              : cross(abs(N.z) < 0.999 ? vec3(0, 0, 1)
                                                       : vec3(0, 1, 0), N);
        vec3 bitangentRaw = abs(tdet) > 1e-12
                                ? ((wp2 - wp0) * d1.x -
                                   (wp1 - wp0) * d2.x) / tdet
                                : cross(N, tangentRaw);
        vec3 T = normalize(tangentRaw - N * dot(N, tangentRaw));
        float handedness = dot(cross(N, T), bitangentRaw) < 0.0
                               ? -1.0 : 1.0;
        vec3 B = normalize(cross(N, T)) * handedness;
        N = normalize(T * nt.x + B * nt.y + N * nt.z);
      }
      // OpenPBR specular_color has a dedicated texture slot and transform;
      // keep SWBVH in lockstep with hardware RT instead of silently falling
      // back to the constant tint when the input is texture-connected.
      int specTexId = matTexIds[mid * 12 + 10];
      bool hasSpecTexture = matTexParams[texParamBase + 131u] > 0.5 ||
                            matTexParams[texParamBase + 139u] > 0.5;
      if (specTexId >= 0 && hasSpecTexture) {
        vec2 specUv = vec2(
            matTexParams[texParamBase + 124u] * uv0.x +
                matTexParams[texParamBase + 125u] * uv0.y +
                matTexParams[texParamBase + 126u],
            matTexParams[texParamBase + 127u] * uv0.x +
                matTexParams[texParamBase + 128u] * uv0.y +
                matTexParams[texParamBase + 129u]);
        specColor *= swSampleTexture(specTexId, specUv, vec2(0.0),
                                     vec2(0.0), sourceFace,
                                     vec4(1.0)).rgb;
      }
    }
    uint graphBase = uint(mid) * 1395u;
#if !LUSDVIEW_SW_DISABLE_MTLX
    if (graphBase + 9u < uint(graphRows.length())) {
      if (graphRows[graphBase + 1u] >= 0.0)
        base = swEvalMaterialXGraph(uint(mid), 0, uv0, uv1,
                                    uint(max(hitTri, 0))).rgb;
      if (graphRows[graphBase + 2u] >= 0.0)
        metallic = clamp(swEvalMaterialXGraph(uint(mid), 1, uv0, uv1,
                                               uint(max(hitTri, 0))).x,
                         0.0, 1.0);
      if (graphRows[graphBase + 3u] >= 0.0)
        roughness = clamp(swEvalMaterialXGraph(uint(mid), 2, uv0, uv1,
                                                uint(max(hitTri, 0))).x,
                          0.03, 1.0);
      if (graphRows[graphBase + 4u] >= 0.0)
        alpha = clamp(swEvalMaterialXGraph(uint(mid), 3, uv0, uv1,
                                           uint(max(hitTri, 0))).x,
                      0.0, 1.0);
      if (graphRows[graphBase + 5u] >= 0.0)
        emissive = max(swEvalMaterialXGraph(uint(mid), 4, uv0, uv1,
                                            uint(max(hitTri, 0))).rgb,
                       vec3(0.0));
      if (graphRows[graphBase + 7u] >= 0.0)
        subsurface = clamp(swEvalMaterialXGraph(uint(mid), 6, uv0, uv1,
                                                uint(max(hitTri, 0))).x,
                           0.0, 1.0);
      if (graphRows[graphBase + 8u] >= 0.0)
        subsurfaceColor = max(swEvalMaterialXGraph(uint(mid), 7, uv0, uv1,
                                                   uint(max(hitTri, 0))).rgb,
                              vec3(0.0));
      if (graphRows[graphBase + 9u] >= 0.0)
        subsurfaceRadius = max(swEvalMaterialXGraph(uint(mid), 8, uv0, uv1,
                                                     uint(max(hitTri, 0))).rgb,
                                vec3(0.0));
      if (graphRows[graphBase + 6u] >= 0.0) {
        vec4 gn = swEvalMaterialXGraph(uint(mid), 5, uv0, uv1,
                                       uint(max(hitTri, 0)));
        vec3 gp0 = xformPoint(inst.o2w,
                              vec3(tris[hitTri * 9 + 0], tris[hitTri * 9 + 1],
                                   tris[hitTri * 9 + 2]));
        vec3 gp1 = xformPoint(inst.o2w,
                              vec3(tris[hitTri * 9 + 3], tris[hitTri * 9 + 4],
                                   tris[hitTri * 9 + 5]));
        vec3 gp2 = xformPoint(inst.o2w,
                              vec3(tris[hitTri * 9 + 6], tris[hitTri * 9 + 7],
                                   tris[hitTri * 9 + 8]));
        vec2 guv0 = vec2(uvs[hitTri * 6 + 0], uvs[hitTri * 6 + 1]);
        vec2 guv1 = vec2(uvs[hitTri * 6 + 2], uvs[hitTri * 6 + 3]);
        vec2 guv2 = vec2(uvs[hitTri * 6 + 4], uvs[hitTri * 6 + 5]);
        vec3 ge1 = gp1 - gp0, ge2 = gp2 - gp0;
        vec3 gN = normalize(cross(ge1, ge2));
        vec2 gd1 = guv1 - guv0, gd2 = guv2 - guv0;
        float gdet = gd1.x * gd2.y - gd1.y * gd2.x;
        vec3 gT = abs(gdet) > 1e-12
                      ? normalize((ge1 * gd2.y - ge2 * gd1.y) / gdet)
                      : normalize(cross(abs(gN.z) < 0.999 ? vec3(0, 0, 1)
                                                          : vec3(0, 1, 0), gN));
        vec3 gB = normalize(cross(gN, gT));
        N = normalize(gT * (gn.x * 2.0 - 1.0) +
                      gB * (gn.y * 2.0 - 1.0) +
                      gN * (gn.z * 2.0 - 1.0));
      }
    }
#endif
    base *= vertColor.rgb;
    alpha *= vertColor.a * inst.tint.a;
      base *= inst.tint.rgb * clamp(baseWeight, 0.0, 1.0);
    float dispersion = clamp(transmissionDispersion *
                              transmissionDispersionScale *
                              (transmissionDispersionAbbe > 0.0
                                   ? 1.0 + 20.0 / max(transmissionDispersionAbbe, 1.0)
                                   : 1.0), 0.0, 1.0);
    transmissionColor *= vec3(1.0 + 0.35 * dispersion, 1.0,
                               1.0 - 0.25 * dispersion);
    base = mix(base, base * coatColor,
               clamp(coatWeight * coatAffectColor, 0.0, 1.0));
    base *= 1.0 - 0.2 * clamp(coatWeight * coatDarkening, 0.0, 1.0);
    roughness = mix(roughness, coatRoughness,
                    clamp(coatWeight * coatAffectRoughness, 0.0, 1.0));
    roughness = clamp(roughness *
                      (1.0 - 0.1 * abs(coatAnisotropy) -
                       0.05 * abs(cos(radians(coatRotation)))), 0.03, 1.0);
    coatRoughness = clamp(coatRoughness *
                          (1.0 + 0.25 * coatRoughnessAnisotropy), 0.03, 1.0);
    roughness = clamp(roughness, 0.03, 1.0);
    float volumeOpacity = clamp(1.0 - exp(-max(volumeDensity, 0.0) * 0.1),
                                0.0, 1.0);
    base = mix(base, base * volumeAlbedo, volumeOpacity);
    emissive += volumeEmission * max(volumeEmissionScale, 0.0) * volumeOpacity;

    // Direct term: evaluate the same packed analytic lights used by the
    // hardware ray-query path. Geometry lights sample one emissive triangle
    // from their resolved target range per shading sample.
    vec3 hit = origin + dir * hitT;
    vec3 V = normalize(-dir);
    float NdotV = max(dot(N, V), 1e-4);
    float specFd = (specIor - 1.0) / (specIor + 1.0);
    vec3 F0 = mix(vec3(specFd * specFd) * specColor, base, metallic);
    F0 = swApplyThinFilm(F0, NdotV, thinFilmWeight,
                         thinFilmThickness, thinFilmIor);
    vec3 direct = vec3(0.0);
    bool hadDirectLight = false;
    uint directLightCount = uint(lightRows.length()) / 20u;
    int renderMode = int(pc.camPos.w + 0.5);
    for (uint li = 0u; li < directLightCount; ++li) {
      vec4 l0 = lightRows[li * 20u + 0u];
      int lightType = int(l0.x + 0.5);
      if (lightType < 0 || lightType > 8) continue;
      int flags = int(l0.y + 0.5);
      if (lightType == 6) continue;
      hadDirectLight = true;
      bool linked = li < 32u
          ? (inst.directLightMask & (1u << li)) != 0u
          : (flags & (1 << 5)) != 0;
      if (!linked) continue;

      vec3 L;
      float maxShadowT = 1e30;
      float attenuation = 1.0;
      vec3 geometryNormal = vec3(0.0);
      // Analytic lights carry their exposure/color-resolved RGB in row 4.
      // Geometry lights retain authored surface emission in row 3.
      vec3 geometryEmission = lightType == 7
                                  ? lightRows[li * 20u + 3u].rgb
                                  : lightRows[li * 20u + 4u].rgb;
      float geometryArea = 1.0;
      if (lightType == 5) {
        vec3 lightDirection = lightRows[li * 20u + 2u].xyz;
        L = -normalize(dot(lightDirection, lightDirection) > 1e-12
                           ? lightDirection : pc.lightDir.xyz);
      } else {
        uint seed = swHash(uint(px.x) * 1973u + uint(px.y) * 9277u +
                            pc.sampleIndex * 26699u + li * 104729u + 31u);
        vec3 lightPosition;
        if (lightType == 7) {
          if (!swSampleGeometryLight(li, seed, lightPosition, geometryNormal,
                                      geometryEmission, geometryArea)) continue;
        } else {
          // PortalLight is a rectangle-shaped environment opening. The
          // rectangle sample provides the visibility/solid-angle guide while
          // the authored portal color carries the environment tint.
          lightPosition = swSampleLightPosition(
              li, lightType == 8 ? 3 : lightType, seed);
        }
        vec3 toLight = lightPosition - hit;
        float dist2 = max(dot(toLight, toLight), 1e-6);
        maxShadowT = sqrt(dist2);
        L = toLight / maxShadowT;
        attenuation = 1.0 / dist2;
        if (lightType == 8) {
          vec3 env = swDomeRadiance(-L);
          if (dot(env, env) > 1e-10) geometryEmission = env;
        }
      }

      float shape = 1.0;
      if ((flags & 4) != 0 && lightType != 5) {
        vec3 lightDir = normalize(lightRows[li * 20u + 2u].xyz);
        float coneCos = dot(lightDir, -L);
        vec4 shaping = lightRows[li * 20u + 6u];
        float outer = cos(radians(clamp(shaping.x, 0.0, 180.0)));
        float inner = cos(radians(clamp(shaping.x * (1.0 - shaping.y),
                                         0.0, 180.0)));
        shape = smoothstep(outer, max(inner, outer + 1e-5), coneCos) *
                pow(max(coneCos, 0.0), max(shaping.z, 0.0));
      }
      if (lightType == 7) {
        shape *= max(dot(geometryNormal, -L), 0.0);
      }
      float nDotL = max(dot(N, L), 0.0);
      if (nDotL <= 0.0 || shape <= 0.0) continue;

      float visibility = 1.0;
      if (renderMode == 0 && (flags & 2) != 0) {
        vec3 shadowOrigin = hit + N * 1e-3;
        float cursor = 1e-3;
        int blendLayers = 0;
        [[dont_unroll]] for (int pass = 0; pass < 32 && visibility > 1e-3; ++pass) {
          int shadowInst, shadowTri; vec2 shadowBc; bool shadowFront;
          float shadowT;
          bool blocked = traceClosestSWRange(
              shadowOrigin, L, cursor, max(maxShadowT - 2e-3, cursor),
              shadowInst, shadowTri, shadowBc, shadowFront, shadowT);
          if (!blocked || shadowT >= maxShadowT - 2e-3) break;
          bool shadowLinked = li < 32u
              ? (insts[shadowInst].shadowLightMask & (1u << li)) != 0u
              : (flags & (1 << 6)) != 0;
          cursor = shadowT + 1e-3;
          if (!shadowLinked) continue;
          float shadowMode = 0.0;
          float opacity = swOpacityAtHit(shadowInst, shadowTri, shadowBc,
                                         shadowMode);
          if (shadowMode > 1.5 && opacity < 1.0 && blendLayers < 8) {
            visibility *= 1.0 - opacity;
            ++blendLayers;
          } else if (shadowMode > 0.5 && shadowMode < 1.5 && opacity <= 0.0) {
            // Rejected alpha-mask texel exposes the next surface.
            continue;
          } else {
            visibility = 0.0;
            break;
          }
        }
      }

      vec3 H = normalize(L + V);
      vec3 tangent = normalize(abs(N.y) < 0.9 ? cross(N, vec3(0.0, 1.0, 0.0))
                                              : cross(N, vec3(1.0, 0.0, 0.0)));
      vec3 bitangent = normalize(cross(N, tangent));
      float rot = radians(specRotation);
      vec3 rotatedT = tangent * cos(rot) + bitangent * sin(rot);
      vec3 rotatedB = -tangent * sin(rot) + bitangent * cos(rot);
      float hT = dot(H, rotatedT), hB = dot(H, rotatedB);
      float nDotH = max(dot(N, H), 0.0);
      float vDotH = max(dot(V, H), 0.0);
      vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - vDotH, 5.0);
      float vT = dot(V, rotatedT), vB = dot(V, rotatedB);
      float lT = dot(L, rotatedT), lB = dot(L, rotatedB);
      float D = swGgxDAniso(nDotH, hT, hB, roughness, specAnisotropy);
      float gV = swGgxG1Aniso(NdotV, vT, vB, roughness, specAnisotropy);
      float gL = swGgxG1Aniso(nDotL, lT, lB, roughness, specAnisotropy);
      vec3 spec = (D * gV * gL * F) /
                  max(4.0 * NdotV * nDotL, 1e-6) * max(specWeight, 0.0);
      vec3 kd = (vec3(1.0) - F) * (1.0 - metallic);
      vec3 sheen = sheenColor * clamp(sheenWeight, 0.0, 1.0) *
                   (0.5 + 0.5 * clamp(sheenRoughness, 0.0, 1.0)) *
                   pow(1.0 - nDotL, 5.0) / 3.14159265;
      vec3 radiance = geometryEmission *
                      (attenuation * shape * swIesFactor(li, -L) *
                       (lightType == 7 ? geometryArea : 1.0));
      vec4 weights = lightRows[li * 20u + 7u];
      vec3 transmissionBrdf = transmissionColor * clamp(transmission, 0.0, 1.0) *
                              (vec3(1.0) - F) / 3.14159265;
      float radiusGain = clamp(sqrt(max(dot(subsurfaceRadius,
                                             vec3(0.2126, 0.7152, 0.0722)) *
                                         subsurfaceScale, 0.0)) * 8.0,
                                0.0, 1.0);
      float diffusionShape = mix(0.25 + 0.75 * pow(1.0 - nDotL, 2.0),
                                 0.25 + 0.75 * (1.0 - nDotL), radiusGain);
      vec3 subsurfaceBrdf = subsurfaceColor * clamp(subsurface, 0.0, 1.0) *
                            diffusionShape / 3.14159265;
      direct += ((kd * base / 3.14159265 + sheen + transmissionBrdf +
                  subsurfaceBrdf) * weights.y +
                 spec * weights.z) *
                nDotL * radiance * visibility;
    }
    if (!hadDirectLight) {
      vec3 L = normalize(pc.lightDir.xyz);
      float nDotL = max(dot(N, L), 0.0);
      vec3 H = normalize(L + V);
      float nDotH = max(dot(N, H), 0.0);
      float vDotH = max(dot(V, H), 0.0);
      vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - vDotH, 5.0);
      float a2 = roughness * roughness * roughness * roughness;
      float dDen = (nDotH * nDotH) * (a2 - 1.0) + 1.0;
      float D = a2 / max(3.14159265 * dDen * dDen, 1e-6);
      float k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
      float gV = NdotV / (NdotV * (1.0 - k) + k);
      float gL = nDotL / (nDotL * (1.0 - k) + k);
      vec3 spec = (D * gV * gL * F) /
                  max(4.0 * NdotV * nDotL, 1e-6);
      vec3 sheen = sheenColor * clamp(sheenWeight, 0.0, 1.0) *
                   (0.5 + 0.5 * clamp(sheenRoughness, 0.0, 1.0)) *
                   pow(1.0 - nDotL, 5.0) / 3.14159265;
      vec3 transmissionBrdf = transmissionColor * clamp(transmission, 0.0, 1.0) *
                              (vec3(1.0) - F) / 3.14159265;
      float radiusGain = clamp(sqrt(max(dot(subsurfaceRadius,
                                             vec3(0.2126, 0.7152, 0.0722)) *
                                         subsurfaceScale, 0.0)) * 8.0,
                                0.0, 1.0);
      float diffusionShape = mix(0.25 + 0.75 * pow(1.0 - nDotL, 2.0),
                                 0.25 + 0.75 * (1.0 - nDotL), radiusGain);
      vec3 subsurfaceBrdf = subsurfaceColor * clamp(subsurface, 0.0, 1.0) *
                            diffusionShape / 3.14159265;
      direct = ((vec3(1.0) - F) * (1.0 - metallic) * base /
                3.14159265 + sheen + transmissionBrdf + subsurfaceBrdf +
                spec * max(specWeight, 0.0)) * nDotL;
    }

    // Ambient: dome-cube diffuse (mip'd roughly by material roughness via
    // the prefiltered cube) -- much simpler than raytrace.comp's split-sum
    // IBL, but reuses the same bound cube/LUT resources.
    vec3 irradiance = textureLod(uEnvCube, N, 0.0).rgb;
    vec3 R = reflect(-V, N);
    vec3 prefiltered = textureLod(uPrefilteredCube, R, roughness * 6.0).rgb;
    vec2 brdf = texture(uBrdfLut, vec2(NdotV, roughness)).rg;
    vec3 ambient = base * (1.0 - metallic) * irradiance * 0.3 +
                   prefiltered * (F0 * brdf.x + brdf.y) * max(specWeight, 0.0);
    ambient += sheenColor * clamp(sheenWeight, 0.0, 1.0) * 0.025;
    ambient += transmissionColor * clamp(transmission, 0.0, 1.0) *
               irradiance * 0.25;

    outc = direct + ambient + emissive;
    if (renderMode == 0) {
      float resolvedHitMode = 0.0;
      float resolvedHitAlpha = swOpacityAtHit(hitInst, hitTri, hitBc,
                                              resolvedHitMode);
      if (resolvedHitMode > 0.5 && resolvedHitMode < 1.5) {
        outc = resolvedHitAlpha > 0.0 ? outc : bgc;
      } else if (resolvedHitMode > 1.5) {
        // Composite the full-shaded nearest layer over a bounded set of
        // resolved underlays. The conservative tail is treated as opaque by
        // the loop once the layer budget is exhausted.
        vec3 layerColor[8];
        float layerAlpha[8];
        vec3 layerTint[8];
        int layerCount = 1;
        float topMode = 0.0;
        layerColor[0] = outc;
        layerAlpha[0] = swOpacityAtHit(hitInst, hitTri, hitBc, topMode);
        layerTint[0] = swLayerTransmissionTint(hitInst, hitTri);
        float topTransmission = swLayerTransmissionWeight(hitInst, hitTri,
                                                          hitBc);
        vec3 refractedOrigin, refractedDir;
        vec3 topRefract = swLayerRefractedColor(hitInst, hitTri, hitBc,
                                                hitFront, origin, dir,
                                                refractedOrigin, refractedDir);
        vec3 walkOrigin = origin;
        vec3 walkDir = dir;
        float cursor = hitT + 1e-3;
        if (topTransmission > 0.0) {
          walkOrigin = refractedOrigin;
          walkDir = refractedDir;
          cursor = 1e-3;
        }
        bool opaqueTail = false;
        vec3 tailColor = bgc;
        [[dont_unroll]] for (int pass = 1; pass < 8; ++pass) {
          int li, lt; vec2 lb; bool lf; float ldist;
          if (!traceClosestSWRange(walkOrigin, walkDir, cursor, 1e30,
                                   li, lt, lb, lf, ldist)) break;
          walkOrigin += walkDir * (ldist + 1e-3);
          cursor = 1e-3;
          float lm = 0.0;
          float la = swOpacityAtHit(li, lt, lb, lm);
          if (lm > 0.5 && lm < 1.5 && la <= 0.0) continue;
          layerColor[layerCount] = swApproxLayerColor(li, lt, lb);
          layerAlpha[layerCount] = la;
          layerTint[layerCount] = swLayerTransmissionTint(li, lt);
          // Carry the refracted direction through each transparent
          // intermediate interface. Without this, stacked glass layers are
          // shaded on a straight ray even though the top interface bent it.
          if (swLayerTransmissionWeight(li, lt, lb) > 0.0) {
            vec3 nextOrigin, nextDir;
            swLayerRefractedColor(li, lt, lb, lf, walkOrigin, walkDir,
                                  nextOrigin, nextDir);
            walkOrigin = nextOrigin;
            walkDir = nextDir;
            cursor = 1.0e-3;
          }
          ++layerCount;
          if (lm <= 0.5 || (lm > 1.5 && la >= 1.0)) break;
        }
        // If the bounded layer budget is exhausted, conservatively treat the
        // next accepted surface as an opaque tail rather than leaking the
        // clear color through an arbitrarily deep transparent stack.
        if (layerCount == 8) {
          int ti, tt; vec2 tb; bool tf; float td;
          if (traceClosestSWRange(walkOrigin, walkDir, cursor, 1e30,
                                  ti, tt, tb, tf, td)) {
            float tm = 0.0;
            float ta = swOpacityAtHit(ti, tt, tb, tm);
            if (!(tm > 0.5 && tm < 1.5 && ta <= 0.0)) {
              opaqueTail = true;
              tailColor = swApproxLayerColor(ti, tt, tb);
            }
          }
        }
        vec3 composite = opaqueTail ? tailColor : bgc;
        // The nearest layer's bounded walk already propagates the refracted
        // direction through subsequent interfaces. Do not start unrelated
        // walks for underlayers found along the original straight camera ray.
        for (int i = layerCount - 1; i >= 1; --i) {
          float a = clamp(layerAlpha[i], 0.0, 1.0);
          vec3 transmitted = composite * layerTint[i];
          composite = mix(transmitted, layerColor[i], a);
        }
        vec3 topTransmitted = composite * layerTint[0];
        topTransmitted = mix(topTransmitted, topRefract,
                             clamp(topTransmission, 0.0, 1.0));
        composite = mix(topTransmitted, layerColor[0],
                        clamp(layerAlpha[0], 0.0, 1.0));
        outc = composite;
      }
    }
  }

  if (pc.accumEnabled != 0u) {
    vec4 sum = imageLoad(accumImg, px);
    sum.rgb = pc.sampleIndex == 0u ? outc : sum.rgb + outc;
    sum.a = 1.0;
    imageStore(accumImg, px, sum);
    outc = sum.rgb / float(pc.sampleIndex + 1u);
  }
  imageStore(outImg, px, vec4(linearToSrgb(outc), 1.0));
#endif
}
