    result += throughput * s.emission;
    result += throughput * swPtSampleDirect(s, iid, -rd, seed);
    float fr = (s.ior - 1.0) / (s.ior + 1.0);
    vec3 f0 = mix(s.specularColor * (fr * fr * s.specularWeight), s.base,
                  s.metallic);
    f0 = swApplyThinFilm(f0, max(dot(s.n, -rd), 0.0), s.thinFilmWeight,
                         s.thinFilmThickness, s.thinFilmIor);
    vec3 diffuseC = s.base * (1.0 - s.metallic) * (1.0 - s.transmission) *
                    (1.0 - s.subsurface);
    vec3 sheenC = s.sheenColor * s.sheenWeight * (1.0 - s.metallic) *
                  (1.0 - s.transmission);
    vec3 interfaceTransmission = s.transmissionDepth > 0.0
        ? vec3(1.0) : s.transmissionColor;
