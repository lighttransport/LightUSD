    float entry = (subsurfaceEvents < maxSubsurfaceEvents ? s.subsurface : 0.0) *
                  (1.0 - s.metallic) * (1.0 - s.transmission);
    vec3 subsurfaceC = (vec3(1.0) - interfaceF) * entry;
    float cr = (s.coatIor - 1.0) / (s.coatIor + 1.0);
    vec3 coatF0 = s.coatColor * cr * cr;
