      float bsdfPdf;
      vec3 f = swPtEvaluateReflection(s, -rd, envDir, diffuseC, f0, sheenC,
                                      coatF0, pd, pg, pcg, bsdfPdf);
      vec3 envVisibility = swPtVisibility(s, envDir, 1.0e30,
                                           32u, 1 << 6);
      if (max(max(envVisibility.r, envVisibility.g), envVisibility.b) >
          1.0e-4) {
