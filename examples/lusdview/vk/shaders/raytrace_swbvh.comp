      if (alphaMode > 1.5) {
        float opacity = swOpacityAtHit(iid, tri, bc, alphaMode);
        float explicitTransmission = alphaMid >= 0
            ? clamp(lrt(alphaMid, 2u).w, 0.0, 1.0) : 0.0;
        float materialIor = alphaMid >= 0
            ? max(lrt(alphaMid, 10u).w, 1.0) : 1.0;
        float authoredOpacity = alphaMid >= 0
            ? (lrt(alphaMid, 12u).w > 0.5
                   ? lrt(alphaMid, 9u).w : mat(alphaMid, 0u).a)
            : 1.0;
