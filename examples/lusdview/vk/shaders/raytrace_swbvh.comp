          ? materialIor : mediumIor[mediumDepth];
      float transmittedIor = boundaryExiting
          ? mediumIor[max(mediumDepth - 1, 0)] : materialIor;
      float eta = incidentIor / transmittedIor;
      if (s.thinWalled) eta = 1.0;
      nextDir = s.thinWalled ? rd : refract(rd, s.n, eta);
      bool tir = dot(nextDir, nextDir) < 1.0e-8;
      if (tir) nextDir = reflect(rd, s.n);
      weight = transmissionC / max(prob, 1.0e-6);
      side = dot(nextDir, s.n) < 0.0 ? -1.0 : 1.0;
      if (!tir && !s.thinWalled) {
        if (!boundaryExiting && mediumDepth < 7) {
          ++mediumDepth; mediumIor[mediumDepth] = materialIor;
          vec3 extinction = s.volumeDensity *
              max(vec3(0.0), vec3(1.0) - s.volumeAlbedo);
          if (s.transmissionDepth > 0.0) {
            float depth = s.transmissionDepth;
            vec3 muT = -log(clamp(s.transmissionColor, vec3(1.0e-6),
                                  vec3(1.0))) / depth;
            vec3 muS = max(s.transmissionScatter, vec3(0.0)) / depth;
            vec3 muA = muT - muS;
            float minA = min(muA.x, min(muA.y, muA.z));
            if (minA < 0.0) muA -= vec3(minA);
            extinction += muA + muS;
          }
          mediumSigma[mediumDepth] = extinction;
          mediumEmission[mediumDepth] = s.volumeEmission;
          mediumInstance[mediumDepth] = iid;
        } else if (boundaryExiting && mediumDepth > 0) {
          int matched = mediumDepth;
          for (int level = mediumDepth; level > 0; --level)
            if (mediumInstance[level] == iid) { matched = level; break; }
          mediumDepth = matched - 1;
        }
      }
      previousDelta = true;
    } else if ((xi -= ws) < 0.0) {
      float prob = ws / sum;
      weight = subsurfaceC / max(prob, 1.0e-6);
      scatterG = clamp(s.subsurfaceAnisotropy +
                           0.5 * s.subsurfaceScatterAnisotropy,
                       -0.95, 0.95);
      vec3 color = clamp(s.subsurfaceColor, vec3(0.0), vec3(0.999999));
      vec3 similarity = vec3(4.09712) + vec3(4.20863) * color -
          sqrt(vec3(9.59217) + vec3(41.6808) * color +
               vec3(17.7126) * color * color);
