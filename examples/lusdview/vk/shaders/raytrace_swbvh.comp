        ? s.ior : mediumIor[mediumDepth];
    float interfaceEtaT = boundaryExiting
        ? mediumIor[max(mediumDepth - 1, 0)] : s.ior;
    float interfaceFr = swPtFresnelDielectric(
        max(dot(s.n, -rd), 0.0), interfaceEtaI, interfaceEtaT);
    vec3 interfaceF = clamp(f0 * (interfaceFr / max(fr * fr, 1.0e-6)),
                            vec3(0.0), vec3(1.0));
