  float priority = 0.0, diameter = 0.86602540378;
  for (int x = -1; x <= 1; ++x) for (int y = -1; y <= 1; ++y)
    for (int z = -1; z <= 1; ++z) {
      ivec3 cp = base + ivec3(x, y, z); vec3 q = p - vec3(cp) - 0.5;
      if (dot(q, q) >= diameter * diameter * 3.0 ||
          mtlxCellNoise(cp, true) > probability) continue;
      float candidate = mtlxCellVec3(cp, 3, true).x;
      if (candidate < priority) continue;
