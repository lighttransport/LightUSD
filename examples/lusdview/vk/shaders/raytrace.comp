vec4 evalMaterialXGraphContext(uint mid, int route, vec2 uv0, vec2 uv1,
                               uint face, vec3 graphNormal,
                               vec3 graphPosition, vec3 graphViewDirection,
                               float sceneTime, float sceneFrame,
                               MeshDesc geomMesh, uint geomI0, uint geomI1,
                               uint geomI2, vec2 geomBc) {
  const uint STRIDE = 1395u;
