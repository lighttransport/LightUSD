  vec2 graphUv = graphRows[p + 15u] > 0.5 ? uv1 : uv0;
  graphUv = graphUv * vec2(graphRows[p + 17u], graphRows[p + 18u]) +
            vec2(graphRows[p + 19u], graphRows[p + 20u]);
  vec4 fallback = vec4(graphRows[p + 4u], graphRows[p + 5u],
                       graphRows[p + 6u], graphRows[p + 7u]);
