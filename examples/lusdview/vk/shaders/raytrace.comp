                   ? sampleRtMaterialTexture(tex, graphUv, face, 0.0, fallback)
                   : fallback;
  if (normalMap)
    value = vec4(normalize(value.xyz * 2.0 - 1.0) * 0.5 + 0.5, value.w);
  return value;
}
