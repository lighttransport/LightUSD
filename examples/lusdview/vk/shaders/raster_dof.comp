#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) readonly uniform image2D sourceColor;
layout(set = 0, binding = 1) uniform sampler2D sourceDepth;
layout(set = 0, binding = 2, rgba8) writeonly uniform image2D outputColor;

layout(push_constant) uniform Params {
  mat4 inverseProjection;
  vec4 lens;
  vec4 extent;
} params;

vec3 srgbToLinear(vec3 c) {
  bvec3 lo = lessThanEqual(c, vec3(0.04045));
  return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, lo);
}

vec3 linearToSrgb(vec3 c) {
  c = max(c, vec3(0.0));
  bvec3 lo = lessThanEqual(c, vec3(0.0031308));
  return mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055,
             c * 12.92, lo);
}

float viewDepth(vec2 uv) {
  float depth = texture(sourceDepth, uv).r;
  if (depth >= 0.999999) return 1.0e30;
  vec4 p = params.inverseProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
  return abs(p.z / max(abs(p.w), 1.0e-8));
}

float cocPixels(float z) {
  if (z > 1.0e20) return 0.0;
  float angular = params.lens.y *
      abs(1.0 / max(z, 1.0e-5) - 1.0 / params.lens.x);
  return clamp(0.5 * params.extent.y * abs(params.lens.z) * angular,
               0.0, params.lens.w);
}

void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(sourceColor);
  if (any(greaterThanEqual(pixel, size))) return;

  const vec2 disk[16] = vec2[16](
    vec2(0.000, 0.000), vec2(0.527, 0.085), vec2(-0.368, 0.284),
    vec2(0.145, -0.547), vec2(-0.705, -0.184), vec2(0.724, -0.438),
    vec2(-0.192, 0.765), vec2(0.423, 0.681), vec2(-0.817, 0.409),
    vec2(0.891, 0.214), vec2(-0.521, -0.691), vec2(0.218, 0.934),
    vec2(-0.941, -0.307), vec2(0.649, -0.724), vec2(-0.070, -0.947),
    vec2(0.982, -0.121));
  vec2 uv = (vec2(pixel) + 0.5) * params.extent.zw;
  float radius = cocPixels(viewDepth(uv));
  if (radius < 0.5) {
    imageStore(outputColor, pixel, imageLoad(sourceColor, pixel));
    return;
  }

  vec3 sum = vec3(0.0);
  float alpha = 0.0;
  float weight = 0.0;
  for (int i = 0; i < 16; ++i) {
    vec2 sampleUv = clamp(uv + disk[i] * radius * params.extent.zw,
                          vec2(0.0), vec2(1.0));
    ivec2 samplePixel = clamp(ivec2(sampleUv * params.extent.xy),
                              ivec2(0), size - ivec2(1));
    vec4 sampleColor = imageLoad(sourceColor, samplePixel);
    float sampleCoc = cocPixels(viewDepth(sampleUv));
    float support = smoothstep(length(disk[i]) * radius - 1.0,
                               length(disk[i]) * radius + 1.0,
                               max(radius, sampleCoc));
    sum += srgbToLinear(sampleColor.rgb) * support;
    alpha += sampleColor.a * support;
    weight += support;
  }
  imageStore(outputColor, pixel,
             vec4(linearToSrgb(sum / max(weight, 1.0e-5)),
                  alpha / max(weight, 1.0e-5)));
}
