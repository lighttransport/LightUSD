{
  "name": "LightUSD JS/WASM demos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:openchess": "node scripts/prepare-openchess.mjs",
    "check:openchess": "node scripts/prepare-openchess.mjs --check",
    "generate:hair-demo": "node scripts/generate-hair-demo.mjs",
    "check:hair-demo": "node scripts/generate-hair-demo.mjs --check",
    "generate:blender-hair": "node scripts/generate-blender-hair.mjs",
    "check:blender-hair": "node scripts/generate-blender-hair.mjs --check",
    "check:optional-assets": "npm run check:hair-demo && npm run check:blender-hair",
