# LightUSD Meson build options
# Source list synchronized with CMakeLists.txt

option('tydra', type: 'boolean', value: false,
       description: 'Build the legacy Tydra scene converter')

# -- Core features (default ON) --
option('builtin_image_loader', type: 'boolean', value: true,
       description: 'Build with built-in image loader (stb_image and fpng)')
option('usdmtlx', type: 'boolean', value: true,
       description: 'Build with MaterialX support')
option('json', type: 'boolean', value: true,
       description: 'Build with JSON support')
option('usdobj', type: 'boolean', value: true,
       description: 'Build with usdObj support (import Wavefront .obj)')
option('usdvox', type: 'boolean', value: true,
       description: 'Build with usdVox support (import MagicaVoxel .vox)')
option('exr', type: 'boolean', value: true,
       description: 'Build with EXR HDR texture support')
option('colorio', type: 'boolean', value: true,
       description: 'Build with Color IO baked LUT support')
option('audio', type: 'boolean', value: true,
       description: 'Build with Audio support (MP3 and WAV)')
option('zstd', type: 'boolean', value: true,
       description: 'Enable zstd compression for USD files')
option('pxr_compat_api', type: 'boolean', value: true,
       description: 'Build with pxr compatible API')

# -- Module control (default ON) --
option('module_usda_reader', type: 'boolean', value: true,
       description: 'Build with USDA reader feature')
option('module_usda_writer', type: 'boolean', value: true,
       description: 'Build with USDA writer feature')
option('module_usdc_reader', type: 'boolean', value: true,
       description: 'Build with USDC reader feature')
option('module_usdc_writer', type: 'boolean', value: true,
       description: 'Build with USDC writer feature')

# -- Optional features (default OFF) --
option('usdfbx', type: 'boolean', value: false,
       description: 'Build with usdFbx support (import FBX)')
option('meshopt', type: 'boolean', value: false,
       description: 'Build with meshoptimizer support')
option('alac_audio', type: 'boolean', value: false,
       description: 'Build with ALAC (M4A) audio support')
option('mcp_server', type: 'boolean', value: false,
       description: 'Build with C++ MCP server (HTTP) support')
option('qjs', type: 'boolean', value: false,
       description: 'Build with QuickJS (JavaScript) support')
option('wamr', type: 'boolean', value: false,
       description: 'Build with WAMR (WebAssembly Micro Runtime) support')
option('geogram', type: 'boolean', value: false,
       description: 'Build with Geogram library for advanced geometry processing')
option('remotery', type: 'boolean', value: false,
       description: 'Build with Remotery profiling support')
option('production_build', type: 'boolean', value: false,
       description: 'Build for production (disable debug print, shorter error messages)')
option('debug_print', type: 'boolean', value: false,
       description: 'Enable debug print (for debugging)')
option('shared_lib', type: 'boolean', value: false,
       description: 'Also build shared library')

# -- System library options --
option('system_zlib', type: 'boolean', value: false,
       description: 'Use system zlib instead of bundled miniz')
option('system_zstd', type: 'boolean', value: false,
       description: 'Use system zstd instead of bundled version')
