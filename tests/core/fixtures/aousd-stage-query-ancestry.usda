#usda 1.0

def Scope "DefParent"
{
    class "ClassChild"
    {
        def Scope "Grandchild"
        {
        }
    }

    over "OverChild"
    {
        def Scope "Descendant"
        {
        }
    }
}

class "ClassParent"
{
    def Scope "Child"
    {
    }
}

def Scope "Inactive" (
    active = false
)
{
    def Scope "Child" (
        active = true
    )
    {
    }
}
