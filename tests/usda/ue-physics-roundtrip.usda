#usda 1.0

def PhysicsScene "PhysicsScene" {
    uniform float3 physics:gravityDirection = (0, 0, -1)
    uniform float physics:gravityMagnitude = 9.81
}

def Xform "RigidBody" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
) {
    bool physics:rigidBodyEnabled = true
    bool physics:kinematicEnabled = false
    float physics:mass = 2.5
    float3 physics:centerOfMass = (0, 0, 0)
}

def Mesh "Collider" (
    prepend apiSchemas = ["PhysicsCollisionAPI"]
) {
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
    uniform token physics:approximation = "convexHull"
}

def PhysicsMaterial "PhysicsMaterial" (
    prepend apiSchemas = ["PhysicsMaterialAPI"]
) {
    float physics:staticFriction = 0.6
    float physics:dynamicFriction = 0.4
    float physics:restitution = 0.2
}

def PhysicsFixedJoint "FixedJoint" {
    rel physics:body0 = </RigidBody>
    rel physics:body1 = </Collider>
    float3 physics:localPos0 = (0, 0, 0)
    float3 physics:localPos1 = (0, 0, 0)
}
