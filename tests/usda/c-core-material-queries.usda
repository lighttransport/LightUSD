#usda 1.0
def Xform "World" {
 def Mesh "Triangle" {
  int[] faceVertexCounts = [3]
  int[] faceVertexIndices = [0,1,2]
  point3f[] points = [(0,0,0),(1,0,0),(0,1,0)]
  rel material:binding = </World/Material>
 }
 def Material "Material" (prepend apiSchemas = ["MaterialXConfigAPI"]) {
  string config:mtlx:version = "1.39"
  string config:mtlx:namespace = "材質"
  string config:mtlx:colorspace = "lin_rec709"
  string config:mtlx:sourceUri = "material.mtlx"
  token outputs:surface.connect = </World/Material/Surface.outputs:surface>
  def Shader "Surface" {
   uniform token info:id = "UsdPreviewSurface"
   color3f inputs:diffuseColor = (0.2,0.4,0.6)
   color3f inputs:diffuseColor.connect = </World/Material/Texture.outputs:rgb>
   color3f inputs:emissiveColor = (0.1,0.2,0.3)
   int inputs:useSpecularWorkflow = 1
   color3f inputs:specularColor = (0.25,0.5,0.75)
   float inputs:metallic = 0.7
   float inputs:roughness = 0.2
   float inputs:roughness.connect = </World/Material/Texture.outputs:r>
   float inputs:clearcoat = 0.3
   float inputs:clearcoatRoughness = 0.4
   float inputs:opacity = 0.8
   float inputs:opacityThreshold = 0.1
   float inputs:ior = 1.6
   normal3f inputs:normal = (0,0,1)
   float inputs:displacement = -0.2
   float inputs:occlusion = 0.9
   token outputs:surface
  }
  def Shader "Texture" {
   uniform token info:id = "UsdUVTexture"
   asset inputs:file = @surface.png@
   float4 inputs:fallback = (0.2,0.4,0.6,1)
   float3 outputs:rgb
   float outputs:r
  }
 }
}
