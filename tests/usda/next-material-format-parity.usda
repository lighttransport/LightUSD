#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World" {
    def Mesh "Surface" {
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Material>
    }

    def Material "Material" {
        token outputs:surface.connect = </World/Material/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:base_roughness = 0.22
            float inputs:base_diffuse_roughness = 0.37
            color3f inputs:transmission_scatter = (0.1, 0.2, 0.3)
            float inputs:transmission_scatter_anisotropy = 0.42
            float inputs:subsurface_anisotropy = 0.18
            float inputs:coat_rotation = 0.28
            float inputs:coat_affect_color = 0.64
            float inputs:coat_affect_roughness = 0.73
            float inputs:sheen_weight = 0.14
            float inputs:fuzz_weight = 0.81
            token outputs:surface
        }
    }
}
