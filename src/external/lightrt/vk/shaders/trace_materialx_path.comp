// Headless triangle MaterialX/OpenPBR path tracer. All variable-sized inputs
// are descriptor-backed SSBOs so the pipeline needs no sampled-image objects or
// window-system resources. Texture pixels are packed RGBA8 uints.
layout(local_size_x = 64) in;
layout(binding=0) uniform accelerationStructureEXT scene;
layout(binding=1, scalar) readonly buffer Vertices { float vertices[]; };
layout(binding=2, scalar) readonly buffer Indices { uint indices[]; };
layout(binding=3, scalar) readonly buffer TriMaterials { uint triMaterials[]; };
layout(binding=4, scalar) readonly buffer Materials { float materials[]; };
layout(binding=5, scalar) readonly buffer Graphs { float graphs[]; };
layout(binding=6, scalar) readonly buffer Texels { uint texels[]; };
layout(binding=7, scalar) readonly buffer TextureDescs { int textureDescs[]; };
layout(binding=8, scalar) readonly buffer Lights { float lights[]; };
layout(binding=9, scalar) writeonly buffer Output { float outputPixels[]; };

layout(push_constant, scalar) uniform Push {
  mat4 invViewProj;
  vec4 camera;       // xyz origin
  vec4 clearColor;   // rgb miss, w exposure
  vec4 context;      // MaterialX time, frame, reserved, reserved
  uvec4 frame;       // width,height,samples,maxDepth
  uvec4 path;        // rrDepth,seed,materialCount,lightCount
} pc;

